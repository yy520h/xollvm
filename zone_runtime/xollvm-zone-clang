#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

real_clang="${XOLLVM_REAL_CLANG:-clang}"
link_clang="${XOLLVM_LINK_CLANG:-$real_clang}"
script_dir="${0%/*}"
helper="${XOLLVM_ZONE_LINK_HELPER:-$script_dir/xollvm_zone_link.py}"
sdk_root="${XOLLVM_ZONE_SDK_ROOT:-$script_dir/..}"
tmp_rsp="${TMPDIR:-/data/data/com.termux/files/usr/tmp}/xollvm-zone-link-$$.rsp"
trap 'rm -f "$tmp_rsp"' EXIT

is_link=1
for arg in "$@"; do
    case "$arg" in
        -c|-S|-E|-emit-llvm) is_link=0 ;;
    esac
done

if [ "$is_link" -eq 0 ]; then
	 exec "$real_clang" "$@"
fi

inputs=()
for arg in "$@"; do
    case "$arg" in
        *.o|*.bc|*.ll) [ -f "$arg" ] && inputs+=("$arg") ;;
    esac
done

if [ "${#inputs[@]}" -eq 0 ]; then
	 exec "$link_clang" "$@"
fi

if ! grep -a -q 'xollvm-zone-v1;' "${inputs[@]}"; then
	 exec "$link_clang" "$@"
fi

if grep -a -q 'xollvm-zone-v1;mode=bundled;' "${inputs[@]}"; then
	archive="${XOLLVM_ZONE_BUNDLED_ARCHIVE:-$sdk_root/private/libxollvm_zone_sdk_private.a}"
	if [ ! -f "$archive" ]; then
		archive="$sdk_root/libxollvm_zone_sdk_private.a"
	fi
	if [ ! -f "$archive" ]; then
		echo "bundled Zone archive not found: $archive" >&2
		exit 1
	fi
	printf '%s\n' "$archive" > "$tmp_rsp"
	 exec "$link_clang" "$@" "@$tmp_rsp"
fi

helper_args=(--sdk-root "$sdk_root" --output "$tmp_rsp")
for arg in "$@"; do
    helper_args+=("--link-arg=$arg")
done
python3 "$helper" "${helper_args[@]}" "${inputs[@]}"
if [ -s "$tmp_rsp" ]; then
	 exec "$link_clang" "$@" "@$tmp_rsp"
fi
exec "$link_clang" "$@"
